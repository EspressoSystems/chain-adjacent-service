# Copy this file to `.env` and fill in real values to run the live AWS
# Secrets Manager integration test:
#   cargo test --lib secrets:: -- --ignored --nocapture
#
# The .env file is gitignored. Credentials are resolved via the default AWS
# credential chain (env vars, shared config files, EC2/ECS metadata, etc.) —
# you can set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# here too, or rely on `aws sso login` / instance role on the machine running
# the test.

AWS_REGION=
AWS_SECRET_ID=
